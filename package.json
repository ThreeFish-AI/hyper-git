			},
			{
				"view": "hyperGit.stash",
				"contents": "No stashes yet.\n[Stash Current Changes](command:hyperGit.stashCreate)"
			},
			{
				"view": "hyperGit.shelf",
				"contents": "No shelves yet. Shelves store patches independently of stash.\n[Shelve Changes…](command:hyperGit.shelveChanges)"
			},
			{
				"view": "hyperGit.worktrees",
				"contents": "No worktrees.\n[New Worktree…](command:hyperGit.worktreeAdd)"
			}
		],
