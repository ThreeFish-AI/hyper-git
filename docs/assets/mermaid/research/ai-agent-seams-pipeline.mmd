    classDef decision fill:#fff9c4,stroke:#f57f17,color:#000
    class Hook1,Hook2,Group,Hook4,Hook5,Resolve hook
    class Gather,Commit,Push engine
    class GenMsg,Split agent
    class Hook3,MsgConfirm,Block decision
